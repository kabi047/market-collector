# Copy to ".env" and fill in. NEVER share, upload or commit .env.

# --- Zerodha Kite Connect (developers.kite.trade -> your app)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# --- Only for automatic daily login on the cloud server (no human needed)
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
# The text secret shown when you enable "External TOTP" in Kite (Settings > Account security).
ZERODHA_TOTP_SECRET=

# --- Optional phone alerts via Telegram (@BotFather -> new bot -> token; message @userinfobot for chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional tuning
# EXTRA_SYMBOLS=IRCTC,ZOMATO          more NSE stocks on top of Nifty 50 + Next 50 + Midcap 50
# LIVE_OPT_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,SENSEX
# LIVE_OPT_STRIKES=20                 strikes each side of ATM recorded live
# LIVE_STOCK_OPTIONS=0                1 = also record near-ATM stock options (many more instruments)
# ANNUAL_REPORTS_PER_COMPANY=3
# DATA_ROOT=E:\Claude Stocks\data
